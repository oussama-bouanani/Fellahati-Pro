rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model: users/{userId}/records/{recordId} is a private farm record.
    // Core fields are required. Optional plot fields are locationLabel,
    // latitude, longitude, and the strictly validated treeCounts map.
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function uidUnchanged(data) { return !('uid' in data) || data.uid == request.auth.uid; }
    function uidNotModified(data) { return !('uid' in data) || data.uid == resource.data.uid; }

    function validTreeCount(treeCounts, key) {
      return !(key in treeCounts) ||
        (treeCounts[key] is int && treeCounts[key] >= 0 && treeCounts[key] <= 1000000);
    }
    function validTreeCounts(data) {
      return !('treeCounts' in data) ||
        (data.treeCounts is map
        && data.treeCounts.keys().hasOnly([
          'olivier','grenadier','figuier','citronnier','oranger','amandier','pommier','vigne',
          'dattier','arganier','clementinier','mandarinier','pamplemoussier','limettier',
          'pecher','nectarinier','abricotier','prunier','cerisier','poirier','cognassier',
          'noyer','noisetier','pistachier','caroubier','avocatier','manguier','bananier',
          'murier','neflier','kakier','cocotier','goyavier','papayer','kiwi','autre-arbre'
        ])
        && validTreeCount(data.treeCounts, 'olivier')
        && validTreeCount(data.treeCounts, 'grenadier')
        && validTreeCount(data.treeCounts, 'figuier')
        && validTreeCount(data.treeCounts, 'citronnier')
        && validTreeCount(data.treeCounts, 'oranger')
        && validTreeCount(data.treeCounts, 'amandier')
        && validTreeCount(data.treeCounts, 'pommier')
        && validTreeCount(data.treeCounts, 'vigne')
        && validTreeCount(data.treeCounts, 'dattier')
        && validTreeCount(data.treeCounts, 'arganier')
        && validTreeCount(data.treeCounts, 'clementinier')
        && validTreeCount(data.treeCounts, 'mandarinier')
        && validTreeCount(data.treeCounts, 'pamplemoussier')
        && validTreeCount(data.treeCounts, 'limettier')
        && validTreeCount(data.treeCounts, 'pecher')
        && validTreeCount(data.treeCounts, 'nectarinier')
        && validTreeCount(data.treeCounts, 'abricotier')
        && validTreeCount(data.treeCounts, 'prunier')
        && validTreeCount(data.treeCounts, 'cerisier')
        && validTreeCount(data.treeCounts, 'poirier')
        && validTreeCount(data.treeCounts, 'cognassier')
        && validTreeCount(data.treeCounts, 'noyer')
        && validTreeCount(data.treeCounts, 'noisetier')
        && validTreeCount(data.treeCounts, 'pistachier')
        && validTreeCount(data.treeCounts, 'caroubier')
        && validTreeCount(data.treeCounts, 'avocatier')
        && validTreeCount(data.treeCounts, 'manguier')
        && validTreeCount(data.treeCounts, 'bananier')
        && validTreeCount(data.treeCounts, 'murier')
        && validTreeCount(data.treeCounts, 'neflier')
        && validTreeCount(data.treeCounts, 'kakier')
        && validTreeCount(data.treeCounts, 'cocotier')
        && validTreeCount(data.treeCounts, 'goyavier')
        && validTreeCount(data.treeCounts, 'papayer')
        && validTreeCount(data.treeCounts, 'kiwi')
        && validTreeCount(data.treeCounts, 'autre-arbre'));
    }
    function validLocation(data) {
      return (!('locationLabel' in data) ||
          (data.locationLabel is string && data.locationLabel.size() <= 160))
        && (!('latitude' in data) ||
          (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) ||
          (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
    }
    function isValidRecord(data) {
      return data.keys().hasOnly([
        'id','kind','cropId','cropName','landId','landName','date','area','areaUnit',
        'quantity','quantityUnit','soldQuantity','unitPrice','amount','category','buyer',
        'season','plantedAt','seedQuantity','notes','photo','locationLabel','latitude',
        'longitude','treeCounts','updatedAt','deviceId','deleted'
      ])
      && data.keys().hasAll([
        'id','kind','cropId','cropName','landId','landName','date','area','areaUnit',
        'quantity','quantityUnit','soldQuantity','unitPrice','amount','category','buyer',
        'season','plantedAt','seedQuantity','notes','photo','updatedAt','deviceId','deleted'
      ])
      && data.id is string && data.id.size() >= 8 && data.id.size() <= 128
      && data.kind in ['land','crop','harvest','sale','expense']
      && data.date is string && data.date.size() == 10
      && data.cropName is string && data.cropName.size() <= 100
      && data.landName is string && data.landName.size() <= 100
      && data.notes is string && data.notes.size() <= 1000
      && data.cropId is string && data.cropId.size() <= 100
      && data.landId is string && data.landId.size() <= 128
      && data.areaUnit is string && data.areaUnit in ['ha','m2']
      && data.quantityUnit is string && data.quantityUnit in ['kg','t']
      && data.category is string && data.category.size() <= 80
      && data.buyer is string && data.buyer.size() <= 120
      && data.season is string && data.season.size() <= 40
      && data.plantedAt is string && data.plantedAt.size() <= 10
      && data.photo is string && data.photo.size() <= 700000
      && data.deviceId is string && data.deviceId.size() <= 128
      && data.area is number && data.area >= 0 && data.area <= 1000000000
      && data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000000
      && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 1000000000
      && data.soldQuantity is number && data.soldQuantity >= 0 && data.soldQuantity <= 1000000000
      && data.seedQuantity is number && data.seedQuantity >= 0 && data.seedQuantity <= 1000000000
      && data.amount is number && data.amount >= 0 && data.amount <= 100000000000
      && data.updatedAt is int && data.updatedAt > 0
      && data.deleted is bool
      && uidUnchanged(data)
      && validLocation(data)
      && validTreeCounts(data);
    }
    match /users/{userId}/records/{recordId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidRecord(request.resource.data)
        && request.resource.data.id == recordId;
      allow update: if isOwner(userId) && isValidRecord(request.resource.data)
        && uidNotModified(request.resource.data)
        && request.resource.data.id == recordId;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
